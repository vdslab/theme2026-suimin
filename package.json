{
  "name": "coffee-flavor-map",
  "version": "1.0.0",
  "description": "味の傾向から自分好みのコーヒー豆を探せる可視化アプリ",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "export:flavor-data": "node scripts/export_public_flavor_data.mjs",
    "deploy": "npm run export:flavor-data && npm run build && npx netlify-cli@27.20.0 deploy --prod --dir=dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdslab/theme2026-suimin.git"
  },
  "keywords": [
    "coffee",
    "visualization",
    "react",
    "d3"
  ],
  "author": "vdslab",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vdslab/theme2026-suimin/issues"
  },
  "homepage": "https://github.com/vdslab/theme2026-suimin#readme",
  "dependencies": {
    "d3-dsv": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "daisyui": "^5.5.20",
    "tailwindcss": "^4.3.0",
    "topojson-server": "^3.0.1",
    "vite": "^8.0.14"
  }
}
